  "rdapp.communityList.subtitle": "Estructura organizacional",

  "rdapp.communityList.description": "Navegue por las publicaciones organizadas jerárquicamente por organismos y sus respectivas colecciones temáticas.",

  "rdapp.communityList.hierarchyButton": "Ver jerarquía",

